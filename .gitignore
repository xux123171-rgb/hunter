# 工具二进制（~264MB）不入库，靠 tools/install-toolchain.sh 重建
bin/*.exe

# nuclei 模板库（数据资产，只留本地；tools/install-toolchain.sh 的 download_templates 拉取）
bin/templates/

# 工作产物 / 归档（每个目标打完即删或单独归档，不随项目走）
scratch/
# 防线：curl -o 落在仓库根的目标产物（侦察数据禁入仓，CONTRIBUTING 规矩的机器化）
/*.html
/*.json
/*.txt
/*.log
/*.db
/*.zip
/*.gz
journal/
reports/
*.tmp

# 系统
Thumbs.db
Desktop.ini
.DS_Store
__pycache__/
*.pyc

# GitHub 推送凭证（只放本地，绝不入库/进聊天）
.hunter-token

# hunter MCP 服务的 Python 虚拟环境（mcp 包，靠 uv venv 重建）
mcp/.venv/
